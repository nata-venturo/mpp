# Salin file ini ke `.env` untuk dev lokal. Untuk image Docker production,
# salin ke `.env.prod` (dipakai docker compose saat build & run — lihat Dockerfile).

# Public resource directory
NEXT_PUBLIC_ASSETS_DIR=

# Galeri referensi komponen (/components) — living docs untuk dev & AI.
# Saat `yarn dev` galeri selalu tampil; di build production hanya tampil
# bila flag ini true. Deploy client: biarkan kosong → seluruh /components 404.
NEXT_PUBLIC_SHOW_COMPONENTS=true

# Backend API (Go marketplace-be) — public URL, reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional server-only override: internal API URL for RSC/sitemap fetches
# (e.g. a k8s service DNS). Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://marketplace-be.default.svc.cluster.local:8080

# Tenant — sent as X-Company-Slug header on all public /api/* endpoints
# (company slug, e.g. "venturo-web" — NOT the client slug)
NEXT_PUBLIC_COMPANY_SLUG=venturo-web

# Whitelabel client slug (one level above company) — reserved for translation
# overrides bootstrap (/core/v1/translation-overrides?slug=...) and endpoints
# that resolve tenant via X-Client-Slug (see products.md §2b)
NEXT_PUBLIC_CLIENT_SLUG=venturo

# Public site origin — canonical URLs, Open Graph, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:8002

# Server-only: bearer token webhook POST /api/revalidate (min 16 karakter) —
# backend/CMS memanggilnya saat konten berubah supaya cache ISR langsung segar.
# Kosongkan untuk menonaktifkan endpoint.
# REVALIDATE_TOKEN=

# ── MPP devices ───────────────────────────────────────────────────────
# Kiosk & TV tidak login sebagai user: keduanya membawa API key ber-scope
# (header X-API-Key) yang dibuat seeder `009_device_keys.sql`.
# NILAI DI BAWAH ADALAH KUNCI DEMO — ganti sebelum deploy nyata.
NEXT_PUBLIC_KIOSK_API_KEY=wiz_test_kiosk001_a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
NEXT_PUBLIC_TV_API_KEY=wiz_test_tvdsp001_f0e1d2c3b4a596870f1e2d3c4b5a69780f1e2d3c4b5a69780f1e2d3c4b5a6978

# Origin WebSocket realtime. Kosongkan untuk menurunkannya dari
# NEXT_PUBLIC_API_URL (http -> ws, https -> wss).
NEXT_PUBLIC_WS_URL=
